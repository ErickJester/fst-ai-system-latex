' ================================================================
'  Diagrama de clases del sistema, partido en cuatro hojas.
'  Cada @startuml es una hoja independiente (PlantUML no reparte
'  un diagrama de clases con newpage). Las clases que no están en
'  la hoja aparecen como referencia con su nombre, sin atributos.
'
'  Generar:
'      java -jar plantuml.jar -tpng diagramas/clases.puml
' ================================================================

@startuml clases_completo
!include estilo_doc.iuml
skinparam classAttributeIconSize 0
skinparam packageStyle rectangle
skinparam nodesep 45
skinparam ranksep 55

' ============ Hoja 1: P1 ============

package P1_Autenticacion_y_usuarios {

  class Usuario {
    -idInstitucional : String
    -nombre : String
    -apellidos : String
    -correo : String
    -contrasenaHash : String
    -activo : Boolean
    -cambioRequerido : Boolean
    +iniciarSesion(correo, contrasena) : String
    +cerrarSesion(token) : void
    +cambiarContrasena(nueva) : void
    +recuperarContrasena(correo) : void
    +actualizarPerfil(datos) : void
    +consultarExperimentos() : List<Experimento>
    +crearExperimento(datos) : Experimento
    +subirVideo(idTanda, sesion, archivo) : Video
    +eliminarExperimento(id) : void
    +descargarReporte(idExperimento, formato) : Reporte
    +reiniciarAnalisis(idAnalisis)
    +ajustarRecuadro(idAnalisis, cilindro, recuadro) : void
    +cancelarAnalisisEnPausa(idAnalisis) : void
  }

  class Administrador {
    +crearCuentaUsuario(datos) : Usuario
    +desactivarCuentaUsuario(id) : void
    +listarUsuarios() : List<Usuario>
    +monitorearSistema() : void
    +modificarCuentaUsuario(id, datos) : void
    +reactivarCuentaUsuario(id)
    +generarContrasenaTemporal(id)
  }
}

class "Experimento" as Experimento_ref
class "Notificacion" as Notificacion_ref

Administrador --|> Usuario

Usuario "1" --> "0..*" Experimento_ref : registra
Usuario "1" --> "0..*" Notificacion_ref : recibe

@enduml

@startuml clases_completo_001
!include estilo_doc.iuml
skinparam classAttributeIconSize 0
skinparam packageStyle rectangle
skinparam nodesep 45
skinparam ranksep 55

' ============ Hoja 2: P2 ============

package P2_Experimentos_y_carga_de_video {

  class Experimento {
    -id : Integer
    -nombre : String
    -fecha : Date
    -notas : String
    +validarNombreUnico() : Boolean
    +consultarEstado() : String
  }

  class Grupo {
    -id : Integer
    -etiqueta : String
    -tipo : String
    -tratamiento : String
  }

  class Tanda {
    -id : Integer
    -ordinal : Integer
    -nCilindros : Integer
  }

  class Especimen {
    -id : Integer
    -numeroCilindro : Integer
  }

  class Video {
    -id : Integer
    -sesion : String
    -archivo : String
    -duracion : Decimal
    -fechaCarga : DateTime
    +validarFormato() : Boolean
    +validarOrientacion() : Boolean
    +validarReproducible() : Boolean
    +estaProximaEliminacion(dias) : Boolean
  }
}

class "Reporte" as Reporte_ref
class "Notificacion" as Notificacion_ref
class "Estadisticas" as Estadisticas_ref

Experimento "1" *--> "0..*" Grupo     : compone
Grupo       "1" *--> "1..*" Tanda     : "se graba en"
Tanda       "1" *--> "2..4" Especimen : aloja
Tanda       "1" *--> "1..2" Video     : produce

Experimento "1"    --> "0..*" Reporte_ref      : origina
Experimento "0..1" --> "0..*" Notificacion_ref : origina
Experimento ..> Estadisticas_ref : calcula
Grupo       ..> Estadisticas_ref : calcula
Tanda       ..> Estadisticas_ref : calcula

@enduml

@startuml clases_completo_002
!include estilo_doc.iuml
skinparam classAttributeIconSize 0
skinparam packageStyle rectangle
skinparam nodesep 45
skinparam ranksep 55

' ============ Hoja 3: P3 ============

package P3_Pipeline_de_analisis_conductual {

  class Worker <<control>> {
    +procesarCola() : void
    +borrarVideosExpirados() : void
    +avisarVencimientos() : void
    +vigilarDisco() : void
    +reencolarHuerfanos() : void
    +cancelarPausasVencidas() : void
  }

  class PipelineAnalisis <<control>> {
    +preprocesarVideo(video) : void
    +detectarCilindros() : List<ROI>
    +clasificarConducta(especimen, roi, segundo) : String
    +generarReporte(experimento, tipo) : Reporte
    +actualizarProgreso(idAnalisis, etapa) : void
    +marcarError(idAnalisis, mensaje) : void
    +pausarAnalisis(idAnalisis) : void
    +guardarImagenPausa(idAnalisis, cilindro, segundo) : void
    +aplicarAjusteRecuadro(idAnalisis) : void
    +cancelarAnalisis(idAnalisis) : void
    +generarCopiaRevision(video) : void
  }

  class ROI {
    -numeroCilindro : Integer
    -x : Integer
    -y : Integer
    -w : Integer
    -h : Integer
    -yAgua : Integer
    -yFondo : Integer
  }
  note right of ROI
    Coordenadas del video ya estabilizado.
    Objeto del pipeline: no se guarda
    en la base de datos.
  end note

  class Analisis {
    -id : Integer
    -estado : String
    -etapa : String
    -nivelClasif : String
    -fechaAnalisis : DateTime
    -rutaDiagnostico : String
  }
}

class "Video" as Video_ref
class "Especimen" as Especimen_ref
class "Observacion" as Observacion_ref
class "Segundo" as Segundo_ref

Worker ..> PipelineAnalisis : invoca
Worker ..> Analisis         : procesa
Worker ..> Video_ref        : elimina

PipelineAnalisis ..> "2..4" ROI  : crea
Especimen_ref "1" --> "0..*" ROI     : "se delimita con"
PipelineAnalisis ..> Video_ref       : procesa
PipelineAnalisis ..> Analisis        : actualiza
PipelineAnalisis ..> Observacion_ref : origina
PipelineAnalisis ..> Segundo_ref     : genera

Analisis "0..1" --> "1" Video_ref : procesa

@enduml

@startuml clases_completo_003
!include estilo_doc.iuml
skinparam classAttributeIconSize 0
skinparam packageStyle rectangle
skinparam nodesep 45
skinparam ranksep 55

' ============ Hoja 4: P4 + P5 ============

package P4_Resultados_y_reportes {

  class Estadisticas <<derivada>> {
    -conducta : Conducta
    -media : Decimal
    -desviacionEstandar : Decimal
    -varianza : Decimal
  }
  note right of Estadisticas
    No persistente: se calcula al consultar.
  end note

  class Observacion {
    +calcularBloques()
  }

  enum Conducta {
    nado activo
    inmovilidad
    escalamiento
    conducta activa
  }

  class Segundo {
    -segundo : Integer
    -conducta : Conducta
    -origen : String
    +corregir(conducta, origen) : void
  }

  class Reporte {
    -id : Integer
    -formato : String
    -ruta : String
    -fechaGeneracion : DateTime
    +generar(experimento, formato) : void
    +descargar() : File
  }
}

package P5_Experimentos_y_notificaciones {

  class Notificacion {
    -id : Integer
    -tipo : String
    -mensaje : String
    -leido : Boolean
    -fechaCreacion : DateTime
    +marcarComoLeida() : void
  }
}

class "Especimen" as Especimen_ref2
class "Video" as Video_ref2

Especimen_ref2 "1" --> "0..1" Observacion : "aparece en"
Video_ref2     "1" --> "0..4" Observacion : contiene

' D-54: 300 es un maximo, sin minimo (los ultimos 300 s del video;
' si dura menos, se guardan todos sus segundos).
Observacion "1" *--> "1..300" Segundo : "se etiqueta en"
Segundo "0..*" --> "0..1" Conducta : "se clasifica como"

@enduml
