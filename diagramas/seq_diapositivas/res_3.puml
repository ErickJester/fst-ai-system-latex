@startuml res_3
!include ../estilo_doc.iuml
skinparam dpi 200
actor Investigador as inv
participant "Interfaz web" as ui
participant Backend as api

api -> api: calcula, por conducta y por minuto, la\nmedia, la desviación estándar, la\nvarianza y el coeficiente de variación
alt el grupo mezcla niveles de clasificación
  api -> api: no promedia el grupo: lo separa por\ntanda
end
api --> ui: datos de las gráficas por grupo, por\nconducta y por minuto
ui -> inv: muestra la galería de seis gráficas del\nDía 2, con selector de conducta, y avisa\nde los faltantes
inv -> ui: descarga en CSV o XLSX lo que ve
@enduml
