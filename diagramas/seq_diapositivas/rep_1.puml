@startuml rep_1
!include ../estilo_doc.iuml
skinparam dpi 200
actor Investigador as inv
participant "Interfaz web" as ui
participant Backend as api
database "Base de datos" as db

inv -> ui: elige el formato (CSV, XLSX, PDF o Excel\ndel experimento) en resultados
ui -> api: pide el reporte en ese formato
api -> db: ¿hay análisis completados en el\nexperimento?
alt no hay análisis completados
  alt CSV, XLSX o Excel del experimento
    api --> ui: rechaza la descarga, con el motivo
    ui --> inv: muestra que no hay resultados todavía
  else PDF
    api --> ui: documento "Sin resultados"
    ui --> inv: descarga ese documento
  end
end
@enduml
