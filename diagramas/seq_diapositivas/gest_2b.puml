@startuml gest_2b
!include ../estilo_doc.iuml
skinparam dpi 200
actor Administrador as admin
participant "Interfaz web" as ui
participant Backend as api
database "Base de datos" as db

admin -> ui: cambia el rol de otro usuario y confirma
ui -> api: pide el cambio de rol
api -> db: ¿quedaría al menos un Administrador\nactivo?
alt no quedaría ninguno
  api --> ui: rechaza: debe existir al menos un\nAdministrador
else sí quedaría
  api -> db: agrega o quita el rol
  ui --> admin: la tabla muestra el rol nuevo
end
@enduml
