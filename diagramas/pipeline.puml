@startuml pipeline
' ================================================================
'  Pipeline de análisis conductual - FST
'  TT 2026-B066 | ESCOM-IPN
' ----------------------------------------------------------------
'  Versión resumida para legibilidad impresa (una actividad por
'  línea). Sin módulo de seguimiento: un espécimen por cilindro.
'  Preprocesamiento solo verifica archivos y lee ancho, alto y
'  duración. La alineación, el fondo, los cilindros, la línea de
'  agua y la revisión de tres segundos sin ver están en cilindros.
'  Clasificación: la red de fusión R(2+1)D-18 recibe el clip de 16
'  cuadros de una ventana de 4 s y una rama de medidas; da tres
'  salidas (escalamiento, inmovilidad, nado). La conducta activa se
'  asigna por segundo con la regla del umbral 0.80.
'  El detalle técnico está en diagramas/guia_web/ (no se toca aquí).
'
'  Generar:
'      java -jar plantuml.jar -tpng diagramas/pipeline.puml
' ================================================================
!include estilo_doc.iuml

start
:Video subido por el usuario;

partition "1. Preprocesamiento" {
  if (¿Se pudo abrir el video?) then (sí)
    :Verifica archivos del análisis;
    :Lee ancho, alto y duración;
  else (no)
    :Genera reporte de diagnóstico;
    stop
  endif
}

partition "2. Cilindros" {
  :Alinea la cámara con un cuadro\nde referencia;
  :Construye el fondo del video;
  :Ubica la línea de agua y el suelo;
  :Separa los cilindros;
  if (¿Se hallaron los cilindros?) then (sí)
    :Calcula la región de cada cilindro;
  else (no)
    :Genera reporte de diagnóstico;
    stop
  endif
  :Mide al espécimen en cada cilindro;
  :Separa al espécimen del fondo,\nsegundo a segundo;
  if (¿Tres segundos seguidos sin ver al espécimen?) then (sí)
    :Guarda imagen fija y datos de la pausa;
    :Pausa el análisis hasta que el\nusuario responda (72 h);
    stop
  endif
}

partition "3. Clasificación de conducta" {
  :Mide 15 rasgos de movimiento y\npostura, y 7 reglas de observación;
  :Conserva los últimos 300 s\nde cada espécimen;
  :Arma, por cada segundo, un clip\nde 4 s alrededor de él;
  :La red da tres salidas: nado,\ninmovilidad y escalamiento;
  :Asigna a cada segundo una conducta\ncon la regla del umbral 0.80;
  :Guarda la copia para revisión,\nlos recuadros y los segundos;
}

partition "4. Resultados" {
  :Calcula totales y bloques de 5 s\nal mostrarse (no se guardan);
}
stop

@enduml
