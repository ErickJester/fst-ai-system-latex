@startuml estados_analisis
!theme plain
skinparam defaultFontName Arial
skinparam defaultFontSize 11
skinparam shadowing false

[*] --> en_cola : se validó y almacenó\nel video (CU-05, RF-12)

state procesando {
  [*] --> preprocesamiento
  preprocesamiento --> deteccion
  deteccion --> seguimiento : [confianza >= 0.70] (RN-11)
  seguimiento --> clasificacion
}

en_cola --> procesando : el Worker tomó la tarea\n(polling, CU-07)
deteccion --> error : [confianza < 0.70] (RN-11)\nse generó el reporte de\ndiagnostico (D-23)
clasificacion --> completado : se completaron las\ncuatro etapas

completado --> [*]
error --> [*]

@enduml
