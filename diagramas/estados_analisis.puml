@startuml estados_analisis
!include estilo_doc.iuml
top to bottom direction

state "clasificación" as clasificacion

[*] --> en_cola : se validó el video

state procesando {
  [*] --> preprocesamiento
  preprocesamiento --> cilindros
  cilindros --> clasificacion : se hallaron\nlos cilindros
}

en_cola --> procesando : el Worker tomó la tarea
preprocesamiento --> error : no se pudo\nabrir el video
cilindros --> error : no se hallaron\nlos cilindros
cilindros --> en_pausa : 3 s seguidos\nsin ver al espécimen
clasificacion --> completado : terminaron\nlas tres etapas
en_pausa --> en_cola : el usuario ajusta o\nconfirma el recuadro
en_pausa --> cancelado : el usuario cancela\no pasan 72 h
procesando --> en_cola : el Worker se apagó\na media tarea
completado --> en_cola : el investigador\nreinició el análisis

completado --> [*]
error --> [*]
cancelado --> [*]

@enduml
