@startuml estados_analisis
!theme plain
skinparam defaultFontName Arial
skinparam defaultFontSize 11
skinparam shadowing false
skinparam nodesep 40
skinparam ranksep 45

state "en cola" as en_cola
state "en pausa" as en_pausa

state procesando {
  state preprocesamiento
  state cilindros
  state "clasificación" as clasificacion
  [*] --> preprocesamiento
  preprocesamiento --> cilindros
  cilindros --> clasificacion : [se hallaron los cilindros]
}

state "Estados finales" as terminado {
  state completado
  state error
  state cancelado
}

[*] --> en_cola : se validó y almacenó\nel video (CU-05, RF-12)
en_cola --> procesando : el Worker tomó la tarea\n(polling, CU-07)

procesando --> en_pausa : [el sistema no ve al espécimen durante\ntres segundos seguidos]\nse notifica al investigador (RF-34)
en_pausa --> procesando : el investigador ajusta\nel recuadro del cilindro
en_pausa --> cancelado : sin respuesta\nen 5 minutos

preprocesamiento --> error : [no se pudo abrir el video]\n(RN-11)
cilindros --> error : [no se hallaron los cilindros]\n(RN-11)\nse generó el reporte de diagnóstico
clasificacion --> completado : se completaron\nlas tres etapas

terminado --> en_cola : el investigador reinicia el análisis\n(se borra el resultado anterior, RN-04)
terminado --> [*]

@enduml
