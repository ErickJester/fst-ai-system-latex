@startuml flujo_general
' ================================================================
'  Flujo general del sistema
'  Base de datos FST | TT 2026-B066 | ESCOM-IPN
'  Frausto Robles Angel Ali . Rodriguez Verdin Sandoval Vanesa
' ----------------------------------------------------------------
'  Reemplaza a docs/diagramas.pdf pagina 2 / figures/mermaid/arquitectura.png
'  (no habia .puml/.mmd fuente, solo la imagen renderizada).
'
'  El clasificador se entrena con clips inequivocos de conducta
'  etiquetados por el equipo (con el etiquetador del equipo) y se
'  prueba con un conjunto de prueba propio: ni para entrenar ni para
'  probar se usan las anotaciones del Dr. Sandino. El bloque de
'  entrenamiento y evaluacion es fuera de linea, antes de usar el
'  sistema, y no es parte del flujo por video; solo el modelo
'  entrenado (nunca el conjunto de prueba) alimenta la clasificacion.
'
'  Sigue marcado "provisional" porque la pregunta abierta de
'  CLAUDE.md ("¿es academicamente aceptable presentar TT-II con solo
'  F1 sobre conjunto de prueba propio?") no esta confirmada con el
'  Dr. Sandino todavia.
'
'  Generar:
'      java -jar plantuml.jar -tpng diagramas/flujo_general.puml
' ================================================================

!theme plain
skinparam defaultFontName Arial
skinparam defaultFontSize 10
skinparam shadowing false
skinparam BackgroundColor White
skinparam ArrowColor      #2C3E50
skinparam ArrowThickness  1.5
skinparam RectangleBorderColor #AAAAAA
skinparam RectangleBorderThickness 2
skinparam DatabaseBorderColor  #AAAAAA
skinparam FolderBorderColor    #AAAAAA

top to bottom direction

rectangle "Video FST" as VID #FFFFFF

rectangle "Entrenamiento y evaluación del modelo (provisional)\n(fuera de línea, antes de usar el sistema -- no es parte del flujo por video)\nSIN anotación del Dr. Sandino, ni para entrenar ni para probar" as REF #FFF9DB {
  rectangle "Clips inequívocos\nde conducta" as CLIPS
  rectangle "Entrenamiento\ndel modelo" as ENT
  database "Modelo entrenado" as MOD
  rectangle "Conjunto de prueba propio\n(clips reservados de los mismos videos,\nno anotación experta)" as TEST
  rectangle "Evaluación\nF1 por conducta (OE-5, RNF-02)" as EVAL

  CLIPS -right-> ENT
  CLIPS -down-> TEST : "reservados"
  ENT -right-> MOD
  MOD -down-> EVAL
  TEST -up-> EVAL
}

rectangle "Sistema web" as WEBBOX #FFF9DB {
  rectangle "Interfaz\nCarga y consulta" as IFZ
  rectangle "API\nGestión de sesiones" as API
  rectangle "Procesamiento asíncrono\n(cola / worker)" as ASYNC

  IFZ -right-> API
  API -right-> ASYNC
}

rectangle "Análisis de conducta" as CONDUCTA #FFF9DB {
  rectangle "Preprocesamiento\n(registro de cámara y modelo de fondo)" as PRE
  rectangle "Clasificación de conducta\n(nado activo, inmovilidad,\nescalamiento y conducta activa)" as CLASIF
  rectangle "Resultados\nTiempos y reporte" as RES

  PRE -right-> CLASIF
  CLASIF -right-> RES
}

rectangle "Almacenamiento" as ALM #FFF9DB {
  database "Archivos\nVideos y reportes" as ARCH
  database "Base de datos\nSesiones y resultados" as BD
}

VID -right-> IFZ
ASYNC -right-> PRE
MOD -down-> CLASIF : "modelo entrenado\n(nunca el conjunto de prueba)"
API -down-> BD
RES -right-> ARCH
RES -down-> BD

@enduml
