@startuml seq_pausa_y_ajuste
' ================================================================
'  Secuencia - Pausa del análisis por espécimen que no se ve,
'  ajuste del recuadro del cilindro, continuación o cancelación
'  Base de datos FST | TT 2026-B066 | ESCOM-IPN
'  Frausto Robles Angel Ali . Rodriguez Verdin Sandoval Vanesa
' ----------------------------------------------------------------
'  la pausa espera al usuario hasta 72 horas.
'  La etapa registrada en la pausa es "cilindros".
'
'  Version de lenguaje natural. Los códigos, rutas y nombres de
'  archivo están en diagramas/guia_web/seq_pausa_y_ajuste.puml.
'
'  Generar:
'      java -jar plantuml.jar -tpng diagramas/seq_pausa_y_ajuste.puml
' ================================================================

!include estilo_doc.iuml

actor Investigador as inv
participant "Interfaz web" as ui
participant Backend as api
database "Base de datos" as db
participant "Archivos" as fs
participant Worker as w

== El Worker pausa el análisis ==

w -> w: ve 3 s seguidos\nsin ver al espécimen
w -> fs: guarda la imagen\nfija y los recuadros
w -> fs: guarda los datos\nde la pausa
w -> db: marca "en pausa"
w -> db: crea la notificación
w -> w: suelta el video y\natiende el siguiente

newpage

== El usuario abre la pausa ==

inv -> ui: abre la notificación
ui -> api: pide los datos\nde la pausa
api -> db: lee el análisis
api -> fs: lee datos e imagen
api --> ui: imagen, recuadro\ny tiempo que queda
ui --> inv: muestra la imagen y\ntres botones:\n"Ajustar y continuar",\n"El recuadro está bien,\ncontinuar" y\n"Cancelar análisis"

newpage

alt el usuario ajusta el recuadro
  inv -> ui: arrastra el recuadro\ny pulsa Ajustar
  ui -> api: envía el recuadro nuevo
  api -> api: revisa el recuadro
  alt el recuadro queda fuera
    api --> ui: rechaza: queda\nfuera de la imagen
    ui --> inv: pide corregirlo
  else casi no cambió (3 px o menos)
    api --> ui: rechaza: casi\nno cambió
    ui --> inv: pide moverlo

    newpage

  else el recuadro es válido
    api -> fs: agrega el recuadro\nnuevo a la pausa
    api -> db: pasa a "en cola" si\nsigue "en pausa"

    newpage

    alt seguía en pausa
      db --> api: confirma
      api --> ui: confirma
      ui --> inv: avisa que continuará\ncuando el sistema esté libre
      note over api
        al retomarse, el video se procesa
        de nuevo desde el principio y el
        recuadro corregido rige desde el
        inicio del primer segundo de esos tres
      end note
    else ya no estaba en pausa
      db --> api: no cambió nada
      api --> ui: "El análisis ya no\nestá en pausa."
      ui --> inv: muestra ese mensaje
    end
  end
else el recuadro está bien

  newpage

  inv -> ui: pulsa "El recuadro\nestá bien, continuar"
  ui -> api: pide continuar
  api -> db: pasa a "en cola" si\nsigue "en pausa"
  alt seguía en pausa
    db --> api: confirma
    api --> ui: confirma
    ui --> inv: avisa que continuará
  else ya no estaba en pausa
    db --> api: no cambió nada
    api --> ui: "El análisis ya no\nestá en pausa."
    ui --> inv: muestra ese mensaje
  end
else el usuario cancela el análisis

  newpage

  inv -> ui: pulsa "Cancelar análisis"
  ui --> inv: pide confirmar:\n«¿Cancelar el análisis?\nNo se puede reanudar:\nhabrá que subir el video\notra vez.»
  inv -> ui: confirma la cancelación
  ui -> api: pide cancelar
  api -> db: pasa a "cancelado" si\nsigue "en pausa"
  note right of api
    no borra archivos, no crea
    notificación ni guarda motivo
  end note
  alt seguía en pausa
    api --> ui: confirma
    ui --> inv: muestra como cancelado
  else ya no estaba en pausa
    api --> ui: "El análisis ya no\nestá en pausa."
    ui --> inv: muestra ese mensaje
  end
end

newpage

== El Worker retoma el análisis ajustado ==

w -> db: toma el análisis en cola\n(conserva su fecha)
w -> db: lo marca "procesando"
w -> fs: lee los datos de la pausa
w -> w: convierte el recuadro nuevo\nal video estabilizado
w -> w: procesa el video desde el principio\ny aplica el recuadro corregido desde\nel inicio del primer segundo de esos tres

newpage

== Si pasan 72 horas sin respuesta ==

loop en cada vuelta de la cola
  w -> db: busca los análisis "en pausa"
  opt el análisis no tiene datos de pausa
    w -> db: pasa a "cancelado" si\nsigue "en pausa"
  end
  opt pasaron más de 72 horas
    w -> db: pasa a "cancelado" si\nsigue "en pausa"
    w -> db: crea la notificación\nde análisis cancelado
  end
end

@enduml
