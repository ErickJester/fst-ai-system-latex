' ================================================================
'  Estilo común de los diagramas de secuencia del documento.
'  Objetivo: letra impresa >= 7 pt en hoja carta (15.6 cm de ancho útil).
'  Uso: !include estilo_doc.iuml  (justo después de @startuml)
' ================================================================
!theme plain
skinparam defaultFontName Arial
skinparam defaultFontSize 16
skinparam shadowing false
skinparam sequenceMessageAlign center
skinparam BoxPadding 4
skinparam sequenceGroupFontSize 15
skinparam noteFontSize 15
skinparam responseMessageBelowArrow true
