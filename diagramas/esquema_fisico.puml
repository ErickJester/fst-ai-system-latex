@startuml esquema_fisico
' ================================================================
'  Esquema fisico de la base de datos - Sistema FST
'  TT 2026-B066 | ESCOM-IPN
'  Frausto Robles Angel Ali . Rodriguez Verdin Sandoval Vanesa
' ----------------------------------------------------------------
'  Figura 5.5 de chapters/05_diseno.tex
'  Gestor: PostgreSQL (D-11) - 12 tablas, 13 llaves foraneas
'  (14-oct: D-102 quita la tabla CONDUCTA; pasa a ser el dominio
'   cerrado tipo_conducta)
'  (14-oct: D-52 quita INTERVALO y PRESENTA; los segundos por
'   conducta de cada minuto se calculan desde SEGUNDO)
'  (6-oct: D-55 quita ESPECIMEN.numeroRata y, con ella, el idGrupo
'   redundante y su disparador (D-04 queda sin objeto). D-53 renombra
'   SEGUNDO.clase como conducta)
'  (5-oct: D-51 quita MODELO, CONFIGURACION y ANALISIS.idConfig;
'   VIDEO.archivo admite nulo; EXPERIMENTO.nombre es UNIQUE;
'   tipo_notificacion gana 'video borrado')
'  (3-oct: D-35 agrega SEGUNDO, una fila por especimen y por segundo,
'   y D-29 agrega la conducta "conducta activa", asi que PRESENTA pasa
'   de (2,3) a (2,4) conductas por intervalo)
'
'  Este diagrama REEMPLAZA POR COMPLETO al esquema fisico anterior
'  (12 tablas: USUARIOS, EXPERIMENTOS, SUJETOS, VIDEOS, ROIS,
'  CONFIGURACIONES_ANALISIS, TRABAJOS, ANIMALES,
'  RESULTADOS_COMPORTAMIENTO, COMPORTAMIENTO_POR_MINUTO, REPORTES,
'  NOTIFICACIONES). Ningun nombre, tipo ni atributo de ese modelo
'  se reutilizo aqui - regla de CLAUDE.md sobre no reciclar
'  contenido de diagramas viejos sin verificar contra el grafo
'  relacional vigente.
'
'  ---- Fuentes ----
'  Estructura  : diagramas/grafo_relacional_3_vigente.puml
'                (12 relaciones, 57 atributos, 13 FK, BCNF)
'  Tipos y DDL : artifact "Diseno Fisico FST" (13-sep) - actividades
'                1 a 6 de la etapa fisica, todas resueltas
'  Decisiones  : errores/preguntas-doctor.md - D-02, D-04, D-08,
'                D-10 a D-18, D-23, D-24
'
'  ---- Que agrega esta etapa sobre el grafo logico ----
'  1. Tipos concretos de PostgreSQL por dominio (ver tabla abajo).
'  2. Nueve dominios cerrados via CREATE DOMAIN + CHECK (D-14 a D-17
'     mas los tres ya cerrados en la etapa logica, y tipo_conducta, D-102).
'  3. D-04 (13-sep) agregaba ESPECIMEN.idGrupo como redundancia; D-55
'     (6-oct) la retira junto con numeroRata. El fisico y el logico
'     tienen las mismas llaves foraneas (13 desde D-102).
'  4. D-24 (15-sep, esta sesion): ANALISIS.idVideo se declara UNIQUE
'     para forzar estructuralmente la cardinalidad (1,1) de D-03.
'     Kendall & Kendall p.425 respalda la "clave unica" como
'     herramienta de integridad de entidad. Efecto en indices: pasa
'     de la lista "hay que declarar el indice" a la de "ya queda
'     indexada" (UNIQUE crea su indice solo) - el artifact "Diseno
'     Fisico FST" todavia no refleja esto (queda pendiente ahi).
'  5. D-23: ANALISIS.rutaDiagnostico, nula salvo estado = 'error'.
'     Se aplica aqui por primera vez a peticion explicita del
'     usuario (15-sep) - hasta ahora estaba solo registrada en
'     preguntas-doctor.md, sin propagar a ningun diagrama.
'
'  ---- Convenciones de tipo (ver artifact para el razonamiento) ----
'  Identificador subrogado -> integer GENERATED ALWAYS AS IDENTITY
'  Identificador institucional (USUARIO) -> varchar(10)      [D-02]
'  Texto corto      -> varchar(n)
'  Texto libre/rutas -> text
'  Fecha sin hora    -> date
'  Marca de tiempo   -> timestamptz
'  Duraciones/segundos -> numeric(p,s)   (nunca
'                       real/double: numeric guarda el decimal
'                       exacto y los totales no acumulan redondeo)
'  Contadores cortos -> smallint
'  Booleano          -> boolean
'
'  ---- Los nueve dominios cerrados (CREATE DOMAIN ... CHECK) ----
'  tipo_conducta           varchar(16) IN ('nado activo',
'                          'inmovilidad','escalamiento',
'                          'conducta activa')                [D-29, D-102]
'  tipo_grupo             varchar(24) IN ('control','referencia',
'                          'tratamiento experimental')
'  sesion_video            varchar(6) IN ('Dia 1','Dia 2')
'                          (el Dia 1 solo confirma que existe el video de
'                          habituacion; se guarda y no se analiza, D-54)
'  formato_reporte         varchar(4) IN ('CSV','XLSX','PDF')
'  tipo_notificacion      varchar(32) IN ('analisis completado',
'                          'error del pipeline','analisis en pausa',
'                          'analisis cancelado','alerta de disco',
'                          'video borrado')                     [D-51]
'  estado_analisis        varchar(10) IN ('en cola','procesando',
'                          'en pausa','completado','error',
'                          'cancelado')                         [D-15]
'  etapa_analisis         varchar(16) IN ('preprocesamiento',
'                          'cilindros','clasificacion')         [D-16]
'  nivel_clasif_analisis   varchar(8) IN ('preciso','agrupado')  [D-17]
'  origen_segundo         varchar(16) IN ('maquina','confirmada',
'                          'corregida','dudosa')                [D-35]
'
'  ---- Todas las FK: ON UPDATE NO ACTION ON DELETE NO ACTION ----
'  La base de datos rechaza el borrado en vez de propagarlo - por
'  eso USUARIO.activo (D-10) existe: dar de baja sin poder borrar.
'
'  ---- CONDUCTA ya no es tabla (D-102, 14-oct) ----
'  Solo SEGUNDO.conducta la usaba, son cuatro valores fijos y no
'  tiene atributos propios: es el dominio cerrado tipo_conducta.
'  Si algun dia cambian las conductas, se modifica el dominio.
'
'  Generar:
'      java -jar plantuml.jar -tpng diagramas/esquema_fisico.puml
' ================================================================

!theme plain
skinparam defaultFontName Arial
skinparam defaultFontSize 9
skinparam shadowing false
skinparam linetype ortho
skinparam classAttributeIconSize 0
skinparam BackgroundColor White
skinparam nodesep 34
skinparam ranksep 42

hide circle

skinparam class {
  BackgroundColor       #FAFAFA
  BorderColor           #3A3A3A
  BorderThickness       1
  HeaderBackgroundColor #1B4F8A
  HeaderFontColor       #FFFFFF
  HeaderFontSize        10
  HeaderFontStyle       bold
  AttributeFontSize     8
  AttributeFontColor    #1A1A1A
}

skinparam arrow {
  Color     #3A3A3A
  Thickness 1
  FontSize  7
  FontColor #3A3A3A
}

' ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
'  DOMINIO EXPERIMENTAL
' ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

entity USUARIO {
  * idInstitucional : varchar(10) <<PK>>
  --
  nombre : varchar(n)
  apellidos : varchar(n)
  correo : varchar(n) <<UK>>
  contrasenaHash : varchar(n)
  activo : boolean
  cambioRequerido : boolean
}
note bottom of USUARIO
  El usuario no se borra: se da de baja con la
  columna activo. La contraseña se guarda con bcrypt
  y sal (RNF-05). cambioRequerido obliga a cambiar la
  contraseña temporal en el primer ingreso (RF-05,
  RF-07, CU-12).
end note

entity EXPERIMENTO {
  * idExperimento : integer <<PK>>
  --
  idInstitucional : varchar(10) <<FK>>
  nombre : varchar(n) <<UK>>
  fecha : date
  notas : text (nulo)
}

entity GRUPO {
  * idGrupo : integer <<PK>>
  --
  idExperimento : integer <<FK>>
  etiqueta : varchar(n)
  tipo : tipo_grupo
  tratamiento : text
  ..
  UK (idExperimento, etiqueta)
}

entity TANDA {
  * idTanda : integer <<PK>>
  --
  idGrupo : integer <<FK>>
  ordinal : smallint
  nCilindros : smallint
  ..
  UK (idGrupo, ordinal)
}

entity ESPECIMEN {
  * idEspecimen : integer <<PK>>
  --
  idTanda : integer <<FK>>
  numeroCilindro : smallint
  ..
  UK (idTanda, numeroCilindro)
}
note bottom of ESPECIMEN
  El espécimen se distingue por su posición en el
  encuadre (numeroCilindro). No se guarda el número con
  que el laboratorio identifica a cada espécimen: no hay
  comparación entre el Día 1 y el Día 2 por espécimen, y
  el reporte solo necesita tanda y posición.
end note

entity VIDEO {
  * idVideo : integer <<PK>>
  --
  idTanda : integer <<FK>>
  sesion : sesion_video
  archivo : text (nulo = video borrado)
  nombreOriginal : varchar(255) (nulo; solo para mostrar, D-114)
  duracion : numeric(p,s)
  fechaCarga : timestamptz
  ..
  UK (idTanda, sesion)
}
note bottom of VIDEO
  El video del Día 1 se guarda y no se analiza: no
  tiene análisis ni observaciones. El archivo queda
  nulo cuando el video se borra.
end note

entity ANALISIS {
  * idAnalisis : integer <<PK>>
  --
  idVideo : integer <<FK>> <<UK>>
  estado : estado_analisis
  etapa : etapa_analisis
  nivelClasif : nivel_clasif_analisis
  fechaAnalisis : timestamptz
  rutaDiagnostico : text (nulo salvo error)
}
note bottom of ANALISIS
  idVideo es único: un video tiene un solo análisis
  vigente, y el reanálisis reemplaza al anterior.
  rutaDiagnostico solo se llena si el estado es
  «error». Al encolar el análisis, etapa, nivelClasif y
  fechaAnalisis llevan un valor de arranque
  (preprocesamiento, preciso y la fecha de encolado) que
  el worker reemplaza. No hay columna de confianza ni de
  configuración: el modelo y el umbral son constantes
  del pipeline. Los recuadros de los
  tubos van en un archivo cuyo nombre sale del id del
  análisis; no se guarda su ruta.
end note

entity OBSERVACION {
  * idObservacion : integer <<PK>>
  --
  idEspecimen : integer <<FK>>
  idVideo : integer <<FK>>
  ..
  UK (idEspecimen, idVideo)
}

entity SEGUNDO {
  * idObservacion : integer <<PK>> <<FK>>
  * segundo : smallint <<PK>>
  --
  conducta : tipo_conducta (nulo = "no se ve")
  origen : origen_segundo
  ..
  CK segundo entre 1 y 300
}
note bottom of SEGUNDO
  Una fila por espécimen y por segundo analizado.
  Es lo que el usuario revisa y corrige al terminar el
  analisis. origen dice si la conducta la puso el sistema
  o la reviso el usuario. conducta es nula si el sistema
  no clasificó el segundo. Hay hasta 300 segundos por
  observacion, los ultimos 300 del video; si el video dura
  menos, se guardan todos (máximo 300, sin mínimo).
end note

entity ADMINISTRADOR {
  * idInstitucional : varchar(10) <<PK>> <<FK>>
}
note bottom of ADMINISTRADOR
  No es un tipo de usuario aparte, es subtipo de
  USUARIO. Su llave primaria es la misma llave foránea.
end note

' ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
'  SOPORTE DEL SISTEMA
' ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

entity REPORTE {
  * idReporte : integer <<PK>>
  --
  idExperimento : integer <<FK>>
  formato : formato_reporte
  ruta : text <<UK>>
  fechaGeneracion : timestamptz
}

entity NOTIFICACION {
  * idNotificacion : integer <<PK>>
  --
  idInstitucional : varchar(10) <<FK>>
  idExperimento : integer <<FK>> (nulo)
  tipo : tipo_notificacion
  mensaje : text
  leido : boolean
  fechaCreacion : timestamptz
}

' ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
'  RELACIONES - 17 FK (las del grafo logico)
'  Todas ON UPDATE NO ACTION ON DELETE NO ACTION
' ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

USUARIO        "1" --o "0..*" EXPERIMENTO              : idInstitucional
USUARIO        "1" --o "0..*" NOTIFICACION              : idInstitucional
USUARIO        "1" --o "0..1" ADMINISTRADOR             : idInstitucional

EXPERIMENTO    "1" --o "3..*" GRUPO                     : idExperimento
EXPERIMENTO    "1" --o "0..*" REPORTE                   : idExperimento
EXPERIMENTO    "0..1" --o "0..*" NOTIFICACION               : idExperimento

GRUPO          "1" --o "1..*" TANDA                     : idGrupo
TANDA          "1" --o "2..4" ESPECIMEN                 : idTanda
TANDA          "1" --o "1..2" VIDEO                     : idTanda

VIDEO          "1" --o "0..1" ANALISIS                  : idVideo <color:#8A5A0B>· única</color>
VIDEO          "1" --o "0..4" OBSERVACION                : idVideo

ESPECIMEN      "1" --o "0..1" OBSERVACION                : idEspecimen

OBSERVACION    "1" --o "1..300" SEGUNDO                 : idObservacion

@enduml
