@startuml estados_experimento
!include estilo_doc.iuml
top to bottom direction

[*] --> sin_videos : se creó el experimento

sin_videos --> en_espera_dia2 : subió solo\nel video del Día 1
sin_videos --> en_cola : subió un video\ndel Día 2
en_espera_dia2 --> en_cola : subió un video\ndel Día 2
en_cola --> procesando : el Worker empezó\nalguna tanda
procesando --> completado : todas las tandas\nterminaron bien
procesando --> error : alguna tanda\nterminó en error
procesando --> en_pausa : alguna tanda\nquedó en pausa
en_pausa --> en_cola : el usuario ajustó\no confirmó el recuadro
en_pausa --> cancelado : el usuario canceló\no pasaron 72 h
completado --> en_cola : se agregó\nuna tanda nueva

note right of error
  Si una tanda está en error,
  el experimento queda en error.
  Prioridad: error, cancelado,
  en pausa, procesando, en cola,
  completado.
end note

@enduml
