@startuml
!pragma layout smetana
title Plataforma Web FST\nPaquete 1 - Autenticación y gestión de usuarios
left to right direction
skinparam packageStyle rectangle
skinparam actorStyle awesome
skinparam usecase {
  BackgroundColor White
  BorderColor DarkSlateGray
}
actor "Investigador" as INV
actor "Administrador" as ADMIN
INV <|-- ADMIN
rectangle "Plataforma Web FST - Paquete 1" {
  usecase "CU-01\nIniciar sesión" as CU01
  usecase "CU-02\nCerrar sesión" as CU02
  usecase "CU-03\nRecuperar contraseña" as CU03
  usecase "CU-16\nCambiar contraseña al primer acceso" as CU16
  usecase "CU-18\nActualizar perfil propio" as CU18
  usecase "CU-11\nGestionar cuenta de usuario" as CU11
  usecase "CU-12\nCrear cuenta de usuario" as CU12
  usecase "CU-17\nDesactivar cuenta de usuario" as CU17
}
INV --> CU01
INV --> CU02
INV --> CU03
INV --> CU18
ADMIN --> CU11
ADMIN --> CU12
CU16 ..> CU01 : <<extend>>\n[la cuenta tiene\ncontraseña temporal]
CU17 ..> CU11 : <<extend>>\n[el Administrador\ndesactiva la cuenta]
@enduml
