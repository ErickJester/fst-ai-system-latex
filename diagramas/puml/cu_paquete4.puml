@startuml
!pragma layout smetana
title Plataforma Web FST\nPaquete 4 - Resultados y reportes
left to right direction
skinparam packageStyle rectangle
skinparam actorStyle awesome
skinparam usecase {
  BackgroundColor White
  BorderColor DarkSlateGray
}
actor "Investigador" as INV
rectangle "Plataforma Web FST - Paquete 4" {
  usecase "CU-09\nConsultar resultados del análisis\n(desglose por minuto y\ncomparación entre grupos del Día 2)" as CU09
  usecase "CU-10\nDescargar reporte\n(PDF, CSV o XLSX)" as CU10
  usecase "Generar archivo de reporte" as UC46
  usecase "CU-25\nRevisar segundo a segundo" as CU25
  usecase "CU-26\nCorregir etiqueta de un segundo" as CU26
  usecase "Reiniciar el análisis" as UC25R
  usecase "CU-27\nConsultar estadísticas de grupo o tanda\n(media, desviación estándar\ny varianza)" as CU27
}
INV --> CU09
INV --> CU10
INV --> CU25
CU10 ..> CU09 : <<extend>>\n[solicita un reporte]
CU10 ..> UC46 : <<include>>
CU26 ..> CU25 : <<extend>>\n[la conducta del sistema\nno es la correcta]
UC25R ..> CU25 : <<extend>>\n[el usuario reinicia\nel análisis]
CU27 ..> CU09 : <<extend>>\n[el investigador pide las\nestadísticas de un grupo o una tanda]
CU27 ..> CU10 : <<extend>>\n[el reporte es CSV o XLSX]
@enduml
