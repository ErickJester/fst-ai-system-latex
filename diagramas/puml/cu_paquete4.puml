@startuml
!pragma layout smetana
title Plataforma Web FST\nPaquete 4 - Resultados y reportes
left to right direction
skinparam packageStyle rectangle
skinparam actorStyle awesome
skinparam usecase {
  BackgroundColor White
  BorderColor DarkSlateGray
}
actor "Investigador" as INV
rectangle "Plataforma Web FST - Paquete 4" {
  usecase "CU-09\nConsultar resultados del analisis" as CU09
  usecase "Desglosar por minuto" as UC42
  usecase "Comparar grupos en Dia 2" as UC43
  usecase "CU-10\nDescargar reporte\n(PDF, CSV o XLSX)" as CU10
  usecase "Generar archivo de reporte" as UC46
  usecase "CU-25\nRevisar segundo a segundo" as CU25
  usecase "CU-26\nCorregir etiqueta de un segundo" as CU26
  usecase "CU-27\nRecalcular totales por minuto" as CU27
}
INV --> CU09
INV --> UC43
INV --> CU10
INV --> CU25
UC42 ..> CU09 : <<extend>>\n[solicita desglose]
CU10 ..> CU09 : <<extend>>\n[solicita un reporte]
CU10 ..> UC46 : <<include>>
CU26 ..> CU25 : <<extend>>\n[la conducta del sistema\nno es la correcta]
CU26 ..> CU27 : <<include>>
@enduml
