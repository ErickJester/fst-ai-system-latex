@startuml
!pragma layout smetana
title Plataforma Web FST\nPaquete 5 - Dashboard, notificaciones y administracion
left to right direction
skinparam packageStyle rectangle
skinparam actorStyle awesome
skinparam usecase {
  BackgroundColor White
  BorderColor DarkSlateGray
}
actor "Investigador" as INV
actor "Administrador" as ADMIN
actor ":Worker:\n<<system>>" as WRK #LightYellow
INV <|-- ADMIN
rectangle "Plataforma Web FST - Paquete 5" {
  usecase "CU-22\nConsultar dashboard" as CU22
  usecase "Filtrar experimentos" as UC51a
  usecase "Avisar expiracion de video" as UC52
  usecase "CU-23\nEliminar experimento" as CU23
  usecase "Confirmar eliminacion" as UC53a
  usecase "CU-14\nBorrar video automaticamente" as CU14
  usecase "Listar usuarios" as UC56
  usecase "CU-13\nMonitorear estado del sistema" as CU13
  usecase "Notificar uso de disco" as UC57a
  usecase "CU-24\nGestionar experimentos globales" as CU24
}
INV --> CU22
INV --> CU23
ADMIN --> UC56
ADMIN --> CU13
ADMIN --> UC57a
ADMIN --> CU24
WRK --> CU14
UC52 ..> CU22 : <<extend>>\n[video expira en < 7 dias]
UC51a ..> CU22 : <<extend>>\n[aplica filtro]
CU23 ..> UC53a : <<include>>
@enduml
