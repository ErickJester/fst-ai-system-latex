# Binarios: nunca aplicar conversión de fin de línea (LF/CRLF).
# core.autocrlf=true en Windows puede corromper bytes internos de estos
# formatos si no se marcan explícitamente como binarios.
*.pdf   binary
*.png   binary
*.jpg   binary
*.jpeg  binary
*.docx  binary
*.pptx  binary
*.xlsx  binary
*.svg   binary

# Entrega del disco: los archivos pesados van por Git LFS (descargarlos con "git lfs pull")
entregaDisco/**/*.gz  filter=lfs diff=lfs merge=lfs -text
entregaDisco/**/*.zip filter=lfs diff=lfs merge=lfs -text
entregaDisco/**/*.mp4 filter=lfs diff=lfs merge=lfs -text
